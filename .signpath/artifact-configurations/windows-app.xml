<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration: windows-app

  What .github/workflows/release.yml uploads before packaging: the desktop
  app's executable, alone, as a GitHub Actions artifact (which is a zip).

  Signed before it goes inside an installer, because an installer cannot be
  reopened to sign what it already contains.

  This file is a copy kept for review. SignPath reads the configuration held in
  the SignPath project, so a change here has to be made there as well.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="WTFault Scanner.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
