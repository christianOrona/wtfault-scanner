<?xml version="1.0" encoding="utf-8"?>
<!-- The interface is served by the diagnostic core inside this app, over
     plain HTTP on the loopback address, so the page and the API share an
     origin (see src/lib.rs). Plain HTTP is allowed there and nowhere else. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
